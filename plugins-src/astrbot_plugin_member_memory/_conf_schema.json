{
  "enabled": {
    "description": "总开关",
    "type": "bool",
    "default": true
  },
  "min_text_len": {
    "description": "少于多少字的发言不做提炼",
    "type": "int",
    "default": 8
  },
  "min_interval_sec": {
    "description": "同一群友两次提炼的最小间隔（秒）",
    "type": "int",
    "default": 120
  },
  "max_notes": {
    "description": "每人最多保留几条档案",
    "type": "int",
    "default": 20,
    "slider": {"min": 5, "max": 100, "step": 5}
  },
  "inject_mode": {
    "description": "档案注入策略",
    "type": "string",
    "options": ["changed", "always", "off"],
    "labels": ["变化时才注入（省 token）", "每轮都注入", "关闭注入"],
    "default": "changed"
  },
  "inject_max_notes": {
    "description": "每轮最多注入几条档案",
    "type": "int",
    "default": 8,
    "slider": {"min": 1, "max": 20, "step": 1}
  }
}

